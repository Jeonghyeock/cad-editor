{
  "name": "cad-editor",
  "productName": "CAD Editor",
  "version": "1.0.0",
  "author": "Jeonghyeock Kim",
  "description": "3D/2D CAD editor (Electron) — sketch & solid modeling workspace",
  "keywords": [],
  "main": ".vite/build/main.js",
  "license": "MIT",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron-forge start",
    "start-local": "cross-env NODE_ENV=development cross-env API_TARGET=local electron-forge start",
    "start-ssh": "cross-env NODE_ENV=development cross-env API_TARGET=ssh electron-forge start",
    "package": "electron-forge package",
    "package-local": "node scripts/package-local.js",
    "make": "electron-forge make",
    "build:native": "set \"PATH=C:\\Program Files\\CMake\\bin;%PATH%\" && cd packages/occt-native && npx cmake-js compile --CDOCCT_ROOT=C:/vcpkg/installed/x64-windows-static",
    "test:unit": "tsx --test test/*.test.ts",
    "test": "npm run test:unit",
    "lint": "eslint --ext .ts,.tsx src",
    "clean": "rimraf node_modules out .vite package-lock.json",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@salusoft89/planegcs": "^1.1.7",
    "electron-squirrel-startup": "^1.0.1",
    "electron-window-state": "^5.0.3",
    "flatted": "^3.3.3",
    "i18next": "^26.2.0",
    "jotai": "^2.12.5",
    "jotai-family": "^1.0.1",
    "lodash": "^4.17.21",
    "occt-import-js": "^0.0.23",
    "opencascade.js": "2.0.0-beta.b5ff984",
    "pretendard": "^1.3.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.30.0",
    "three": "^0.175.0",
    "three-bvh-csg": "^0.0.17"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.10.0",
    "@electron-forge/maker-dmg": "^7.10.0",
    "@electron-forge/maker-rpm": "^7.10.0",
    "@electron-forge/maker-squirrel": "^7.10.0",
    "@electron-forge/maker-zip": "^7.10.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.0",
    "@electron-forge/plugin-fuses": "^7.10.0",
    "@electron-forge/plugin-vite": "^7.10.0",
    "@types/lodash": "^4.17.15",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.175.0",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/vite-plugin": "^5.1.0",
    "classnames": "^2.5.1",
    "cross-env": "^7.0.3",
    "electron": "^35.2.1",
    "electron-devtools-installer": "^3.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-typescript": "^3.8.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.6.2",
    "sass": "^1.85.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "vite": "^6.3.4",
    "vite-plugin-checker": "^0.9.1",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "lint-staged": {
    "*.+(ts|tsx)": [
      "npm run lint"
    ]
  }
}
