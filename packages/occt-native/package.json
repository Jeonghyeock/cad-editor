{
  "name": "@cad-editor/occt-native",
  "version": "0.1.0",
  "description": "OCCT C++ Native Addon for CAD Editor — STEP import, B-Rep, Boolean",
  "main": "src/ts/index.js",
  "types": "src/ts/index.d.ts",
  "scripts": {
    "install": "cmake-js compile",
    "build": "cmake-js compile --CDCMAKE_BUILD_TYPE=Release",
    "build:debug": "cmake-js compile --CDCMAKE_BUILD_TYPE=Debug",
    "rebuild": "cmake-js rebuild",
    "clean": "cmake-js clean",
    "test": "node --test test/"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "cmake-js": "^7.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "binary": {
    "napi_versions": [9]
  }
}
